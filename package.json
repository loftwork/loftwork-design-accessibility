{
  "name": "loftwork-design-accessibility",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "validate:master": "node content-source/practice-master-v1.0/validate.mjs",
    "validate:editorial": "node content-source/editorial-content-v1.0/validate.mjs",
    "validate:references": "node scripts/validate-reference-data.mjs",
    "validate:content": "npm run validate:master && npm run validate:editorial && npm run validate:references",
    "generate:content": "node scripts/generate-content.mjs",
    "prepare:content": "npm run validate:content && npm run generate:content",
    "predev": "npm run prepare:content",
    "dev": "astro dev",
    "prestart": "npm run prepare:content",
    "start": "astro dev",
    "precheck": "npm run prepare:content",
    "check": "astro check",
    "prebuild": "npm run prepare:content",
    "build": "astro build",
    "verify": "node scripts/verify-build.mjs",
    "check:all": "npm run check && npm run build && npm run verify",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
