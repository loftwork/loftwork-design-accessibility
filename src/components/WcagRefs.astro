---
import { getWcagCriterion, type WcagId } from '../data/wcag';

interface Props {
	ids: readonly WcagId[];
}

const { ids } = Astro.props;
const criteria = ids.map(getWcagCriterion);
---

<ul class="wcag-refs" aria-label="関連するWCAG 2.2達成基準">
	{criteria.map((criterion) => (
		<li>
			<a
				href={criterion.understandingUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`${criterion.id} ${criterion.titleJa}の解説書（新しいタブで開く）`}
			>
				<span class="criterion-id">{criterion.id}</span>
				<span>{criterion.titleJa}</span>
			</a>
			<span class="level">Level {criterion.level}</span>
		</li>
	))}
</ul>

<style>
	.wcag-refs {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.wcag-refs li {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.6rem;
		align-items: baseline;
	}

	.wcag-refs a {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.6rem;
		align-items: baseline;
	}

	.criterion-id,
	.level {
		font-variant-numeric: tabular-nums;
		font-weight: 700;
	}

	.level {
		padding: 0.05rem 0.45rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		font-size: var(--sl-text-xs);
	}
</style>
