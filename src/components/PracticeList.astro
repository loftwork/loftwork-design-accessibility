---
import { getCollection } from 'astro:content';
import {
	conditionLabels,
	phaseLabels,
	phaseWeightLabels,
	requirementLabels,
} from '../data/content-labels';
import {
	getLens,
	getPracticesByPhase,
	practices as allPractices,
	type Phase,
	type Practice,
} from '../data/practice-master';
import { getWcagCriterion } from '../data/wcag';

interface Props {
	primaryLens?: string;
	phase?: Phase;
}

const { primaryLens, phase } = Astro.props;
const entries = await getCollection('docs');
const summaryById = new Map(
	entries
		.filter((entry) => entry.data.contentType === 'practice')
		.map((entry) => [(entry.data as { practiceId: string }).practiceId, entry.data.description ?? '']),
);

let practices: Practice[] = phase ? getPracticesByPhase(phase) : [...allPractices];
if (primaryLens) practices = practices.filter((practice) => practice.primaryLens === primaryLens);

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const phaseOrder: Phase[] = ['decide', 'design', 'review'];
---

<ol class="practice-list">
	{practices.map((practice) => {
		const primaryPhases = phaseOrder.filter((key) => practice.phases[key] === 'primary');
		const supportingPhases = phaseOrder.filter((key) => practice.phases[key] === 'supporting');

		return (
			<li>
				<article>
					<p class="practice-id">{practice.id}</p>
					<h3><a href={`${baseUrl}practices/${practice.id.toLowerCase()}/`}>{practice.title}</a></h3>
					<p>{summaryById.get(practice.id)}</p>
					<dl class="metadata" aria-label={`${practice.id}のメタデータ`}>
						{phase ? (
							<div>
								<dt>このフェーズでの位置づけ</dt>
								<dd>{phaseWeightLabels[practice.phases[phase]!]}</dd>
							</div>
						) : (
							<>
								<div class="wide">
									<dt>主に判断するフェーズ</dt>
									<dd><ul class="tags">{primaryPhases.map((key) => <li>{phaseLabels[key]}</li>)}</ul></dd>
								</div>
								{supportingPhases.length > 0 && (
									<div class="wide">
										<dt>あわせて確認するフェーズ</dt>
										<dd><ul class="tags supporting">{supportingPhases.map((key) => <li>{phaseLabels[key]}</li>)}</ul></dd>
									</div>
								)}
							</>
						)}
						<div>
							<dt>要求レベル</dt>
							<dd>{requirementLabels[practice.requirement]}</dd>
						</div>
						<div>
							<dt>適用</dt>
							<dd>{conditionLabels[practice.condition]}</dd>
						</div>
						{practice.relatedLens.length > 0 && (
							<div class="wide">
								<dt>関連するLens</dt>
								<dd>
									<ul class="tags">
										{practice.relatedLens.map((id) => {
											const lens = getLens(id);
											return <li><a href={`${baseUrl}lens/${id}/`}>{lens.title}</a></li>;
										})}
									</ul>
								</dd>
							</div>
						)}
						<div class="wide">
							<dt>関連するWCAG 2.2</dt>
							<dd>
								<ul class="wcag-tags">
									{practice.wcag.map(({ id }) => {
										const criterion = getWcagCriterion(id);
										return (
											<li>
												<a href={`${baseUrl}standards/wcag/#criterion-${id.replaceAll('.', '-')}`}>{id} {criterion.titleJa}</a>
												<span class="level">Level {criterion.level}</span>
											</li>
										);
									})}
								</ul>
							</dd>
						</div>
					</dl>
				</article>
			</li>
		);
	})}
</ol>

<style>
	.practice-list { display: grid; gap: 1rem; margin: 1.5rem 0; padding: 0; list-style: none; }
	.practice-list article { padding: clamp(1rem, 2vw, 1.35rem); border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; }
	.practice-list h3 { margin-block: 0.2rem 0.5rem; }
	.practice-id { margin: 0; font-size: var(--sl-text-sm); font-weight: 700; letter-spacing: 0.04em; }
	.metadata { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.75rem 1.25rem; margin-block: 1rem 0; padding-block-start: 0.9rem; border-block-start: 1px solid var(--sl-color-gray-5); color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); }
	.metadata > div { min-width: 0; }
	.metadata .wide { grid-column: 1 / -1; }
	.metadata dt { margin-block-end: 0.3rem; font-size: var(--sl-text-xs); font-weight: 700; letter-spacing: 0.02em; }
	.metadata dd { margin: 0; color: var(--sl-color-text); }
	.tags, .wcag-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
	.tags li, .wcag-tags li { margin-block-start: 0; padding: 0.15rem 0.55rem; border: 1px solid var(--sl-color-gray-5); border-radius: 999px; background: var(--sl-color-gray-7); }
	.supporting li { border-style: dashed; }
	.wcag-tags li { display: inline-flex; flex-wrap: wrap; gap: 0.35rem; align-items: baseline; }
	.wcag-tags .level { font-size: var(--sl-text-xs); font-weight: 700; }
</style>
