---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PracticeMeta from './PracticeMeta.astro';

const data = Astro.locals.starlightRoute.entry.data;
const practiceId = data.contentType === 'practice' ? (data as { practiceId: string }).practiceId : undefined;
---

<Default />
{practiceId && <PracticeMeta practiceId={practiceId} />}
