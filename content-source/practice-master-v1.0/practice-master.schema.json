{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loftwork:accessible-design:practice-master:v1.0",
  "title": "Loftwork Accessible Design Guide Practice Master v1.0",
  "type": "object",
  "required": ["version", "contentModelVersion", "requirementPolicyVersion", "lenses", "vocabulary", "policy", "practices"],
  "properties": {
    "version": { "const": "1.0" },
    "contentModelVersion": { "const": "0.4" },
    "requirementPolicyVersion": { "const": "1.0" },
    "lenses": { "type": "array", "minItems": 7, "maxItems": 7 },
    "vocabulary": { "type": "object" },
    "policy": { "type": "object" },
    "practices": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": { "$ref": "#/$defs/practice" }
    }
  },
  "$defs": {
    "phaseWeight": { "enum": ["primary", "supporting", null] },
    "wcag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-4]\\.[1-9]\\.[1-9][0-9]*$" },
        "level": { "enum": ["A", "AA"] }
      }
    },
    "requirementOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement"],
      "properties": {
        "wcag": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "appliesTo": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "requirement": { "enum": ["baseline", "project-dependent"] }
      },
      "anyOf": [{ "required": ["wcag"] }, { "required": ["appliesTo"] }]
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "primaryLens", "relatedLens", "priority", "requirement", "condition", "phases", "handoff", "wcag"],
      "properties": {
        "id": { "type": "string", "pattern": "^(PE|ST|NV|OP|UN|IN|AD)-[0-9]{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "primaryLens": { "enum": ["perceive", "structure", "navigate", "operate", "understand", "input", "adapt"] },
        "relatedLens": {
          "type": "array",
          "items": { "enum": ["perceive", "structure", "navigate", "operate", "understand", "input", "adapt"] },
          "maxItems": 2,
          "uniqueItems": true
        },
        "priority": { "const": "standard" },
        "requirement": { "enum": ["baseline", "project-dependent"] },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirementOverride" }, "minItems": 1 },
        "condition": { "enum": ["always", "conditional"] },
        "appliesTo": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decide", "design", "review"],
          "properties": {
            "decide": { "$ref": "#/$defs/phaseWeight" },
            "design": { "$ref": "#/$defs/phaseWeight" },
            "review": { "$ref": "#/$defs/phaseWeight" }
          }
        },
        "handoff": { "type": "array", "items": { "const": "development" }, "uniqueItems": true },
        "wcag": { "type": "array", "items": { "$ref": "#/$defs/wcag" }, "minItems": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "condition": { "const": "conditional" } } },
          "then": { "required": ["appliesTo"] },
          "else": { "not": { "required": ["appliesTo"] } }
        }
      ]
    }
  }
}
